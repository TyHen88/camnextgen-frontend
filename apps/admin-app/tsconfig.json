{
  "extends": "../../packages/config/tsconfig/next.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "src/*"
      ],
      "@camnextgen/ui": [
        "../../packages/ui/src"
      ],
      "@camnextgen/lib": [
        "../../packages/lib/src"
      ],
      "@camnextgen/types": [
        "../../packages/types/src"
      ],
      "@camnextgen/i18n": [
        "../../packages/i18n/src"
      ]
    },
    "allowJs": true,
    "isolatedModules": true
  },
  "include": [
    "next-env.d.ts",
    "src",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
